# keep CRLF exactly as stored, raw.githubusercontent.com serves the blob as-is
*.cmd -text

# Line endings by what runs the file, not by what the machine checking it out prefers.
# install.sh is piped straight into bash from a raw url, where a CR would come through as part of
# every line.
*.ps1 text eol=crlf
*.sh text eol=lf

# The built tool, committed so a clone is usable without a build
*.jar binary
